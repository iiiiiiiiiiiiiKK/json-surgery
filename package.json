{
  "name": "json-surgery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "JSON Surgery — a fast, private, browser-local JSON workbench: format, validate, inspect, query, diff and analyze JSON without ever uploading your data.",
  "author": "KK (@0xkillcoin)",
  "license": "MIT",
  "homepage": "https://iiiiiiiiiiiiiKK.github.io/json-surgery/",
  "repository": {
    "type": "git",
    "url": "https://github.com/iiiiiiiiiiiiiKK/json-surgery.git"
  },
  "bugs": {
    "url": "https://github.com/iiiiiiiiiiiiiKK/json-surgery/issues"
  },
  "keywords": [
    "json",
    "json-viewer",
    "json-formatter",
    "json-validator",
    "json-diff",
    "jsonpath",
    "json-tools",
    "offline",
    "privacy",
    "developer-tools"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.1",
    "@codemirror/view": "^6.36.2",
    "@lezer/highlight": "^1.2.1",
    "jsonpath-plus": "^10.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
